// FFEX IOS - Xcode Build Configuration
// Target: iOS 15.0+, arm64
// Product type: Framework (embedded into IPA)

PRODUCT_NAME = FFEX
PRODUCT_BUNDLE_IDENTIFIER = com.ffex.ios.cheat
INFOPLIST_FILE = Info.plist

// Platforms
SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES

// Build
GCC_OPTIMIZATION_LEVEL = s
SWIFT_OPTIMIZATION_LEVEL = -O
ENABLE_BITCODE = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
STRIP_INSTALLED_PRODUCT = YES
DEPLOYMENT_POSTPROCESSING = YES

// Frameworks / Linker
MACH_O_TYPE = mh_dylib
DYLIB_INSTALL_NAME_BASE = @rpath
FRAMEWORK_VERSION = A
SKIP_INSTALL = YES

// Signing — ad-hoc for sideload
CODE_SIGN_IDENTITY = -
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = YES
EXPANDED_CODE_SIGN_IDENTITY = -

// Other flags
GCC_PREPROCESSOR_DEFINITIONS = FFEX_IOS=1 $(inherited)
OTHER_LDFLAGS = -ObjC -lz -framework Foundation -framework UIKit -framework Security

// Obfuscation note:
// Source is obfuscated pre-build via obfuscate.sh (string XOR + symbol rename)
// Final binary > 1GB due to embedded decoy data blobs (padding to confuse size-based AC)
